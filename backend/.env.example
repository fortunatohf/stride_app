# Copy to .env for local development
DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgis://stryde:stryde@localhost:5432/stryde
REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline (no worker needed) while developing
CELERY_TASK_ALWAYS_EAGER=True
# Fernet key for watch tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
WEBHOOK_SECRET=change-me-long-random
PUBLIC_BASE_URL=http://localhost:8000
# Filled in after each developer program approves STRYDE
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
SENTRY_DSN=
